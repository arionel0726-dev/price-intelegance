# Production environment template - copy to .env.production and fill in
# real values. NEVER commit .env.production (already gitignored).
#
# Used two ways:
#   - docker-compose.prod.yml interpolates ${VAR} from this file when run
#     with `docker compose --env-file .env.production -f docker-compose.prod.yml ...`
#   - the `api` service also loads it directly via `env_file:`, so
#     everything below reaches the API container as a real env var.

# --- PostgreSQL ---
POSTGRES_DB=price
POSTGRES_USER=price
# Long, random, production-only value - do not reuse the local dev password.
POSTGRES_PASSWORD=change-me

# DATABASE_URL is built from the POSTGRES_* values above inside
# docker-compose.prod.yml (postgres:5432, Docker DNS) - do not set it here,
# it would be overridden anyway.

# --- Auth (shared internal account - no user table) ---
AUTH_EMAIL=manager@example.com
AUTH_PASSWORD=change-me
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_TTL=86400
# TEMPORARY escape hatch for serving over plain HTTP (e.g. bare VPS IP,
# before a domain/TLS cert exists) - browsers drop Secure cookies over HTTP.
# Leave "true" once real HTTPS is in place; only the literal value "false"
# disables Secure.
AUTH_COOKIE_SECURE=true

# --- Cross-origin / routing ---
# Same-origin production (Nginx routes both / and /api/* under one host) -
# WEB_ORIGIN is mostly a formality here (CORS isn't actually exercised for
# same-origin requests) but keep it accurate for any direct/CLI calls.
WEB_ORIGIN=https://price.vizaje-nica.com
NODE_ENV=production

# --- Scheduled jobs (apps/api/src/jobs/) ---
# Leave unset/false until the stack has been verified end-to-end at least
# once - every job stays manually runnable via `docker compose exec api
# bun run jobs:*` regardless of this flag. Only ever set on the api service.
ENABLE_SCHEDULED_JOBS=false

# --- MAKEUP discovery pacing/safety (see
# apps/api/src/competitors/makeup-discovery-pacing.ts for defaults/reasoning
# - override only with real evidence from THIS deployment's own behavior) ---
# MAKEUP_DISCOVERY_BATCH_SIZE=25
# MAKEUP_DISCOVERY_BATCH_PAUSE_MS=90000
# MAKEUP_COOLDOWN_THRESHOLD=7
# MAKEUP_COOLDOWN_WAIT_MS=720000
# MAKEUP_COOLDOWN_PROBE_SIZE=3
# MAKEUP_MAX_COOLDOWN_EVENTS_PER_RUN=2
# MAKEUP_MAX_DEFERRED_RATIO=0.3
# MAKEUP_MAX_SEARCH_ERROR_RATIO=0.1

# Per-run target counts for the two discovery jobs.
# MAKEUP_DISCOVERY_RUN_LIMIT=250
# OVICO_DISCOVERY_RUN_LIMIT=15

# --- JobVN.json (barcode enrichment - see DEPLOYMENT.md) ---
# Absolute path on the HOST VPS to the private JobVN.json file. Mounted
# read-only into the api container - never baked into the image.
JOBVN_HOST_PATH=/opt/price-monitoring/private-data/JobVN.json
