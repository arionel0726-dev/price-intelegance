PORT=3001
DATABASE_URL=postgresql://price:price@localhost:5432/price
PARSER_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Shared internal login - one account, no user database.
AUTH_EMAIL=manager@example.com
AUTH_PASSWORD=change-me
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_TTL=86400

# Optional override for the JobVN.json barcode-enrichment lookup path used by
# the Vizaje website sync. Defaults to <repo-root>/data/vizaje/JobVN.json.
# VIZAJE_JSON_PATH=/absolute/path/to/JobVN.json

# Scheduled jobs (apps/api/src/jobs/) are wired but OFF by default - each
# @Cron only actually fires once this is explicitly set to "true". Leave
# unset/false for local development; every job remains manually runnable via
# `bun run jobs:*` regardless of this flag. All 5 jobs run on the
# Europe/Chisinau timezone.
# ENABLE_SCHEDULED_JOBS=true

# MAKEUP discovery pacing/safety (see competitors/makeup-discovery-pacing.ts
# for defaults and reasoning) - override only with real evidence.
# MAKEUP_DISCOVERY_BATCH_SIZE=25
# MAKEUP_DISCOVERY_BATCH_PAUSE_MS=90000
# MAKEUP_COOLDOWN_THRESHOLD=7
# MAKEUP_COOLDOWN_WAIT_MS=720000
# MAKEUP_COOLDOWN_PROBE_SIZE=3
# MAKEUP_MAX_COOLDOWN_EVENTS_PER_RUN=2
# MAKEUP_MAX_DEFERRED_RATIO=0.3
# MAKEUP_MAX_SEARCH_ERROR_RATIO=0.1

# Per-run target counts for the two discovery jobs.
# MAKEUP_DISCOVERY_RUN_LIMIT=250
# OVICO_DISCOVERY_RUN_LIMIT=15
